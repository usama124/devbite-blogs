TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=YOUR_TURSO_AUTH_TOKEN
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Keep disabled during normal development. Enable only for a deliberate schema update.
PAYLOAD_DB_PUSH=false

# Cloudflare R2 (all five values are required to enable cloud media storage)
R2_BUCKET=devbite-blogs-media
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.devbite.dev
